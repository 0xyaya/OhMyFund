# Install as /home/neo/.config/myfund/api.env with mode 0600. Never commit values.
DB_USER=myfund
DB_PASSWORD=replace-with-random-password
DB_NAME=myfund
# URL-encode DB_PASSWORD before composing the production connection URL.
DATABASE_URL=
# Exact browser origins, comma-separated. Do not use wildcards.
WEB_ORIGIN=https://temporary-vercel-production-domain.vercel.app,https://myfund-preview.vercel.app
PUBLIC_API_HOST=api.example.com
TRUSTED_PROXY_SECRET=
TURNKEY_ORGANIZATION_ID=
# Dedicated non-root deployed backend credential. Never reuse it on a developer machine.
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# Separate restricted Turnkey credential and wallet used only to sponsor Solana fees.
TURNKEY_SPONSOR_ORGANIZATION_ID=
TURNKEY_SPONSOR_WALLET_ID=
TURNKEY_SPONSOR_WALLET_ADDRESS=
TURNKEY_SPONSOR_API_PUBLIC_KEY=
TURNKEY_SPONSOR_API_PRIVATE_KEY=
TURNKEY_SPONSOR_DELEGATED_USER_ID=
# Separate global policy for one-time, user-co-signed ATA setup transactions.
TURNKEY_SETUP_SPONSOR_POLICY_ID=
POLICY_PROVISIONER_URL=http://policy-provisioner:4311
POLICY_PROVISIONER_SHARED_SECRET=
TURNKEY_POLICY_PROVISIONER_API_PUBLIC_KEY=
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Authorization can be enabled while execution remains disabled.
RECURRING_BUYS_AVAILABLE=false
EXECUTION_ENABLED=false
# Independent gate for sponsor-signing one-time token-account setup transactions.
SETUP_EXECUTION_ENABLED=false
JUPITER_API_KEY=
JUPITER_FEE_ACCOUNT=
JUPITER_FEE_ACCOUNT_AUTHORITY=
RECURRING_DEFAULT_SLIPPAGE_BPS=100
RECURRING_WORKER_CONCURRENCY=2
RECURRING_ALLOWLIST_USER_IDS=
RECURRING_MAX_OCCURRENCE_ATOMIC=10000000
RECURRING_MAX_DAILY_ATOMIC=20000000
RECURRING_MAX_NETWORK_FEE_ATOMIC=50000
RECURRING_MINIMUM_NET_INVESTMENT_ATOMIC=1000000
RECURRING_MAX_SPONSORED_LAMPORTS_PER_TRANSACTION=3000000
RECURRING_MAX_SPONSORED_LAMPORTS_PER_USER_DAILY=10000000
RECURRING_MAX_SPONSORED_LAMPORTS_GLOBAL_DAILY=100000000
RECURRING_SPONSOR_MINIMUM_BALANCE_LAMPORTS=10000000
RECURRING_SOL_PRICE_MAXIMUM_AGE_SLOTS=150
# Setup reimburses exact token-account rent and network cost in USDC, without
# the recurring 0.75% platform fee. These are hard sponsor/rate limits.
SETUP_MAX_REIMBURSEMENT_ATOMIC=5000000
SETUP_MAX_SPONSORED_LAMPORTS_PER_TRANSACTION=30000000
SETUP_MAX_SPONSORED_LAMPORTS_PER_USER_DAILY=60000000
SETUP_MAX_SPONSORED_LAMPORTS_GLOBAL_DAILY=300000000
SETUP_COMPUTE_UNIT_PRICE_MICROLAMPORTS=1000
